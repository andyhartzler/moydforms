NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by src/lib/googleSheets.ts + googleDrive.ts to dual-write
# membership + chartering submissions into the legacy response sheets and
# Drive folders for continuity with the pre-moydforms Zapier pipeline.
# Paste the full contents of the backend-everything service account key file
# as a single JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"backend-everything","client_email":"...","private_key":"..."}'
GOOGLE_DWD_SUBJECT=andrew@moyoungdemocrats.org

# Google Drive Picker (optional - for file uploads from Google Drive)
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-api-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
