{
  "slug": "endorsement-questionnaire-2026-v2",
  "title": "MOYD Candidate Endorsement Questionnaire (Policy Alignment)",
  "description": "The Missouri Young Democrats alignment questionnaire. One open-ended question plus 50 scored items (multiple choice + true/false) keyed to the MOYD 2025 Policy Platform. Generates an overall progressive-alignment score (0-100) and per-policy-area sub-scores used by the endorsement committee.",
  "version": 2,
  "status": "proposal",
  "based_on_platform": "MOYD 2025 Policy Platform (adopted November 11, 2025)",
  "scoring": {
    "methodology": "weighted-aligned-count",
    "description": "Each scored question has a MOYD-aligned answer and an integer weight 1-5. Overall score = (sum of weights of aligned answers) / (sum of all weights) * 100. Per-policy-area scores use the same formula restricted to questions tagged with that area. Questions where the candidate picks an MC option marked aligned=true, or answers a true/false question matching moyd_aligned_answer, count as aligned. The open-ended narrative is not scored — it is displayed alongside the score.",
    "spectrum_axes": ["overall_progressive_score", "per_policy_area"],
    "max_score": 100,
    "interpretation_bands": [
      {"min": 85, "max": 100, "label": "Strongly aligned — Progressive"},
      {"min": 70, "max": 84, "label": "Aligned — Progressive-leaning"},
      {"min": 55, "max": 69, "label": "Mixed — Moderate Democrat"},
      {"min": 40, "max": 54, "label": "Weakly aligned — Conservative Democrat"},
      {"min": 0, "max": 39, "label": "Not aligned with MOYD platform"}
    ],
    "weights_legend": {
      "5": "Core MOYD plank — non-negotiable platform position",
      "4": "Major platform priority",
      "3": "Platform position with internal flexibility",
      "2": "Secondary / tactical preference",
      "1": "Style or emphasis question"
    }
  },
  "policy_areas": [
    "economy_labor",
    "healthcare",
    "education",
    "environment_climate",
    "civil_rights_lgbtq",
    "reproductive_rights",
    "criminal_justice",
    "democracy_voting",
    "housing",
    "immigration",
    "gun_policy",
    "tax_fiscal",
    "foreign_policy",
    "youth_specific",
    "narrative"
  ],
