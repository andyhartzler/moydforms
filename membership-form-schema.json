      "help": "Everyone's journey looks different — students, workers, job seekers, all are welcome. This helps us shape opportunities that fit where you are right now.",
      "required": false,
      "pageNumber": 4
    },
    {
      "id": "69d07773",
      "type": "radio",
      "label": "Are you currently enrolled in school?",
      "required": true,
      "pageNumber": 4,
      "options": [
        { "value": "Yes", "label": "Yes" },
        { "value": "No", "label": "No" },
        { "value": "Prefer not to say", "label": "Prefer not to say" }
