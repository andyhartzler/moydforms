{
  "fields": [
    {
      "id": "header_welcome",
      "type": "section_header",
      "label": "Welcome to Missouri Young Democrats! 🎉",
      "help": "We're so glad you're here. Whether you're a first-time voter, a seasoned organizer, or just looking for your political community — you belong here. Let's start with the basics.",
      "required": false,
      "pageNumber": 1
    },
    {
      "id": "7ef3d9a0",
      "type": "text",
      "label": "First Name",
      "placeholder": "Your first name",
      "required": true,
      "pageNumber": 1
    },
    {
      "id": "7221a225",
      "type": "text",
      "label": "Last Name",
      "placeholder": "Your last name",
      "required": true,
      "pageNumber": 1
    },
    {
      "id": "562e6d09",
      "type": "date_picker",
      "label": "Date of Birth",
      "required": true,
      "pageNumber": 1,
      "help": "MOYD membership is open to ages 14–36."
    },
    {
      "id": "email_field",
      "type": "email",
      "label": "Email Address",
      "placeholder": "you@example.com",
      "required": true,
      "pageNumber": 1,
      "help": "Please use a personal email — not a work or school address."
    },
    {
      "id": "458e9ec2",
      "type": "phone",
      "label": "Phone Number",
      "placeholder": "(555) 555-5555",
      "required": false,
      "pageNumber": 1
    },

    {
      "id": "header_location",
      "type": "section_header",
      "label": "Where Are You? 📍",
      "help": "This helps us connect you with your local chapter and ensures you're represented in the right districts. Your address is required for YDA (Young Democrats of America) membership.",
      "required": false,
      "pageNumber": 2
    },
    {
      "id": "73400ed5",
      "type": "text",
      "label": "City/Town of Residence",
      "placeholder": "Kansas City, Springfield, Columbia...",
      "required": true,
      "pageNumber": 2
    },
    {
      "id": "207879c2",
      "type": "text",
      "label": "Street Address",
      "placeholder": "123 Main St, Apt 4",
      "required": true,
      "pageNumber": 2,
      "help": "Including apartment or suite number. Required by YDA for all members."
    },
    {
      "id": "41db9d9c",
      "type": "radio",
      "label": "State",
      "required": true,
      "pageNumber": 2,
      "options": [
        { "value": "Missouri", "label": "Missouri" },
        { "value": "Other", "label": "Other" }
      ]
    },
    {
      "id": "23cca2cb",
      "type": "text",
      "label": "Zip Code",
      "placeholder": "63101",
      "required": true,
      "pageNumber": 2,
      "validation": {
        "pattern": "^[0-9]{5}(-[0-9]{4})?$",
        "message": "Please enter a valid zip code"
      }
    },
    {
      "id": "3a456eeb",
      "type": "checkbox_group",
      "label": "Preferred Pronouns (Select all that apply)",
      "required": false,
      "pageNumber": 2,
      "options": [
        { "value": "She/her", "label": "She/her" },
        { "value": "He/him", "label": "He/him" },
        { "value": "They/them", "label": "They/them" },
        { "value": "Ze/zir", "label": "Ze/zir" },
        { "value": "Xe/xem", "label": "Xe/xem" },
        { "value": "Any pronouns", "label": "Any pronouns" },
        { "value": "Prefer not to say", "label": "Prefer not to say" }
      ]
    },
    {
      "id": "559c0f96",
      "type": "radio",
      "label": "Are you registered to vote in Missouri?",
      "required": true,
      "pageNumber": 2,
      "help": "Not sure? <a href='https://www.sos.mo.gov/elections/voterlookup' target='_blank' class='text-primary-600 underline'>Check your status here</a>",
      "options": [
        { "value": "Yes", "label": "Yes" },
        { "value": "No", "label": "No" },
        { "value": "Unsure", "label": "Unsure" }
      ]
    },

    {
      "id": "header_social",
      "type": "section_header",
      "label": "Let's Connect! 📱",
      "help": "Social media is one of the best ways we build momentum and keep you in the loop. Drop your handles if you're comfortable — we'd love to follow you!",
      "required": false,
      "pageNumber": 3
    },
    {
      "id": "596e8a46",
      "type": "text",
      "label": "Instagram",
      "placeholder": "@yourusername",
      "required": false,
      "pageNumber": 3
    },
    {
      "id": "6428fdf1",
      "type": "text",
      "label": "TikTok",
      "placeholder": "@yourusername",
      "required": false,
      "pageNumber": 3
    },
    {
      "id": "417477cd",
      "type": "text",
      "label": "X (formerly Twitter)",
      "placeholder": "@yourusername",
      "required": false,
      "pageNumber": 3
    },
    {
      "id": "011b2200",
      "type": "text",
      "label": "Bluesky",
      "placeholder": "@you.bsky.social",
      "required": false,
      "pageNumber": 3
    },

    {
